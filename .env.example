# outcomes.xyz 环境变量（复制为 .env 本地开发用；
# Vercel 部署时在 Project Settings → Environment Variables 里配置同名变量）

# 【必填】你的 builder 地址（收费用）
# 要求：perps 账户价值 >= 100 USDC，账户抽象模式为 standard
VITE_BUILDER_ADDRESS=0x0000000000000000000000000000000000000001

# builder fee，单位：十分之一基点。100 = 0.1%，1000 = 1%（outcome 上限）
VITE_BUILDER_FEE_TENTHS_BPS=100

# 请求用户授权的最高费率（必须 >= 实际收费率）
VITE_BUILDER_MAX_FEE_RATE=0.1%

# 测试网开关：true = api.hyperliquid-testnet.xyz，false / 不设置 = 主网
VITE_IS_TESTNET=false

# 接口失败时是否显示演示数据：生产环境建议 false
VITE_USE_MOCK_FALLBACK=false
